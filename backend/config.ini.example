[server]
host = 0.0.0.0
port = 8000
base_url = /api/v1
run_schema_init = true
run_scheduler = true

[database]
host = localhost
port = 3308
user = root
password = root
name = flight_booking

[security]
session_expire_hours = 24
reset_token_expire_minutes = 60
pbkdf2_iterations = 260000

[rate_limit]
login = 10
window_seconds = 300

[cors]
origins = *

[email]
enabled = false
from = noreply@flightbooking.demo

[logging]
level = INFO
file =
